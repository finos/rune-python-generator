namespace rosetta_dsl.test.robustness.generator_defects : <"Regression tests for known Python generator defects (D15 and related, gap G39). Each function exercises one defective pattern directly, without the Rune workaround, so the test fails if the defect is present and passes if it has been fixed.">

// ── Defect: set a->b->c on an absent b does not create b ─────────────────────
// Expected: the generator creates InnerValue when result.inner is absent.
// Defective: raises AttributeError / returns None for result.inner.

type InnerValue:
    value int(1..1)

type OuterContainer:
    inner InnerValue(0..1)

func SetThroughAbsent:
    inputs:
        val int(1..1)
    output:
        result OuterContainer(1..1)
    set result -> inner -> value: val


// ── Defect: single item given to a list attribute in a constructor is not wrapped ─
// Expected: result.items == [item].
// Defective: result.items == item (scalar, fails pydantic list validation).

type IntList:
    items int(1..*)

func ConstructListFromSingle:
    inputs:
        inp int(1..1)
    output:
        result IntList(1..1)
    set result:
        IntList { items: inp }


// ── Defect: add to an absent list fails ──────────────────────────────────────
// Expected: result.values == [val] after the first add.
// Defective: raises AttributeError (NoneType has no attribute append).

type IntAccumulator:
    values int(0..*)

func AddToAbsentList:
    inputs:
        val int(1..1)
    output:
        result IntAccumulator(1..1)
    add result -> values: val


// ── Defect: function called inside filter is not imported ────────────────────
// Expected: FilterNonNegative([1, -2, 3]) == [1, 3].
// Defective: NameError — IsNonNegative not imported in the generated FilterNonNegative module.

func IsNonNegative:
    inputs:
        v int(1..1)
    output:
        result boolean(1..1)
    set result:
        v >= 0

func FilterNonNegative:
    inputs:
        vals int(0..*)
    output:
        result int(0..*)
    set result:
        vals filter IsNonNegative(item)


// ── Defect: if-then-else inside extract builds a closure that misses item ────
// Expected: ConditionalExtract([2, -3, 0]) == [2, 0, 0]
//           (positives kept; non-positives become 0).
// Defective: NameError for item inside then/else branch, or wrong values.

func ConditionalExtract:
    inputs:
        vals int(0..*)
    output:
        result int(0..*)
    set result:
        vals extract (if item > 0 then item else 0)


// ── Defect: empty (absent) function result is [] instead of None ─────────────
// A function whose output is optional and resolves to absent should return None.
// Expected: EmptyWhenFalse(val: -1) is None.
// Defective: EmptyWhenFalse(val: -1) == [] (empty list).

func EmptyWhenFalse:
    inputs:
        val int(1..1)
    output:
        result int(0..1)
    set result:
        if val > 0
        then val
        else empty
